# =============================================================================
# Peach Payments — PRODUCTION credentials (template)
# =============================================================================
# Copy this file to backend/.env.peach-production and fill in your live values.
# This file is loaded ONLY when running:
#     npx ts-node scripts/test-peach-payments.ts --prod
#
# DO NOT commit backend/.env.peach-production to git.
# Ensure backend/.gitignore excludes it.
# =============================================================================

# Live Peach OAuth credentials (from production dashboard.peachpayments.com)
PEACH_CLIENT_ID=909942642d5cf95996b3d0ca06673e
PEACH_CLIENT_SECRET=wClB678HErNuANH6NDjxqu2grkclVKGINFg7Sz4KauWfhtC56YBHulHSDvCIvS9hxnlK08X4OaEFaINqXbRj5w==
PEACH_MERCHANT_ID=7f3bb619b41a4aafb8a1f89416275b45

# Live channel/entity ID (production, NOT the test entity)
PEACH_ENTITY_ID=8ac9a4c8732312de0173392d2c506ded
# Optional static token (only if your account still uses legacy bearer auth)
PEACH_ACCESS_TOKEN=OGFjOWE0Y2Q3MzIzMGJlYTAxNzMzOGI5MzAzZjMxN2F8eHJrWlFqN3A3Wg==

# Production endpoints (do not change unless Peach gives you different URLs)
PEACH_BASE_URL=https://secure.peachpayments.com
PEACH_AUTH_URL=https://dashboard.peachpayments.com

# Must be false on production
PEACH_TEST_MODE=false

# Webhook URL (server-to-server notifications from Peach)
PEACH_NOTIFICATION_URL=https://api.effmemberportal.org/api/v1/payments/webhook/peach

# Merchant domain — used as Origin/Referer and as the shopper redirect.
# MUST match a domain whitelisted under Peach dashboard \u2192 Channels \u2192 Allowed Origins.
# The test script derives the merchant origin from this URL's protocol+host.
PEACH_SHOPPER_RESULT_URL=https://effmemberportal.org/payment-result
